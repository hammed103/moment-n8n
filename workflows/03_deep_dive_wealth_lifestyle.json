    {
      "parameters": {
        "jsCode": "// Wealth + Lifestyle deep dives.\n// Targets: Collector + Dealer rank>=8 + all Watchless UHNWI.\n// Dedup: Wealth Data sheet (wealth done), Lifestyle Data sheet (lifestyle done).\nconst wealthDone = new Set();\nfor (const item of $('Read Wealth Data').all()) {\n  const u = (item.json.username || '').toLowerCase();\n  if (u) wealthDone.add(u);\n}\nconst lifestyleDone = new Set();\nfor (const item of $('Read Lifestyle Data').all()) {\n  const u = (item.json.username || '').toLowerCase();\n  if (u) lifestyleDone.add(u);\n}\n\nconst tasks = [];\n\n// Collector + Dealer tabs, rank 8-10\nfor (const item of [...$('Read Collector').all(), ...$('Read Dealer').all()]) {\n  const p = item.json;\n  const rank = parseInt(p.visible_watch_rank) || 0;\n  if (rank < 8) continue;\n  const u = (p.username || '').toLowerCase();\n  if (!wealthDone.has(u)) tasks.push({ json: { username: p.username, kind: 'wealth' } });\n  if (!lifestyleDone.has(u)) tasks.push({ json: { username: p.username, kind: 'lifestyle' } });\n}\n\n// Watchless UHNWI (all entries)\nfor (const item of $('Read Watchless UHNWI').all()) {\n  const p = item.json;\n  const u = (p.username || '').toLowerCase();\n  if (!u) continue;\n  if (!wealthDone.has(u)) tasks.push({ json: { username: p.username, kind: 'wealth' } });\n  if (!lifestyleDone.has(u)) tasks.push({ json: { username: p.username, kind: 'lifestyle' } });\n}\n\n// Ensure 'wealth' runs before 'lifestyle' for the same user (Lifestyle is UHNWI-gated on Wealth output)\ntasks.sort((a, b) => {\n  const ua = a.json.username.toLowerCase();\n  const ub = b.json.username.toLowerCase();\n  if (ua !== ub) return ua < ub ? -1 : 1;\n  if (a.json.kind === 'wealth' && b.json.kind === 'lifestyle') return -1;\n  if (a.json.kind === 'lifestyle' && b.json.kind === 'wealth') return 1;\n  return 0;\n});\n\nreturn tasks;"
      },
      "id": "build-tasks",
      "name": "Build Wealth+Lifestyle Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
