    {
      "parameters": {
        "jsCode": "// Pick verified rank 8-10 from Sheet A and all UHNI from Sheet B as new flywheel seeds\nconst existingSeeds = new Set();\nfor (const s of $('Read Existing Seeds').all()) {\n  if (s.json.username) existingSeeds.add(s.json.username.toLowerCase());\n}\n\nconst targets = [];\nfor (const item of $('Read Sheet A').all()) {\n  const rank = parseInt(item.json.visible_watch_rank) || 0;\n  if (rank < 8) continue;\n  const u = (item.json.username || '').toLowerCase();\n  if (!u || existingSeeds.has(u)) continue;\n  targets.push({ json: { username: u, seed_type: 'follower_loop', source_sheet: 'A' } });\n}\nfor (const item of $('Read Sheet B').all()) {\n  const u = (item.json.username || '').toLowerCase();\n  if (!u || existingSeeds.has(u)) continue;\n  targets.push({ json: { username: u, seed_type: 'follower_loop', source_sheet: 'B' } });\n}\nreturn targets;"
      },
