    {
      "parameters": {
        "jsCode": "// Build new seed rows from following list, dedup against existing seeds\nconst existingSeeds = new Set();\nfor (const s of $('Read Existing Seeds').all()) {\n  if (s.json.username) existingSeeds.add(s.json.username.toLowerCase());\n}\nconst sourceTarget = $('Process Each Target').item.json.username;\nconst rows = [];\nfor (const item of $input.all()) {\n  const u = (item.json.username || '').toLowerCase();\n  if (!u || existingSeeds.has(u)) continue;\n  existingSeeds.add(u);\n  rows.push({ json: {\n    username: u,\n    seed_type: 'follower_loop',\n    original_url: `https://www.instagram.com/${u}/`,\n    source_target: sourceTarget\n  }});\n}\nreturn rows;"
      },
